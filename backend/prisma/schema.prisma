datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Initial placeholder model for Phase 1 verification
model HealthCheck {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
}
