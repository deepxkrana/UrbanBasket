# ==============================================================================
# UrbanBasket Root Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database & Supabase (PostgreSQL & Storage)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/urbanbasket?schema=public
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/urbanbasket?schema=public
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# Upstash Redis (Serverless KV store for Cart & Search Cache)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
REDIS_URL=redis://localhost:6379

# Payments (Choose 'stripe' or 'razorpay')
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
